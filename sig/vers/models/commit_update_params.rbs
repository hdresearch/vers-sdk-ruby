module Vers
  module Models
    type commit_update_params =
      { commit_id: String } & Vers::Internal::Type::request_parameters

    class CommitUpdateParams < Vers::Models::UpdateCommitRequest
      extend Vers::Internal::Type::RequestParameters::Converter
      include Vers::Internal::Type::RequestParameters

      def commit_id: -> String

      def commit_id=: (String _) -> String

      def initialize: (
        commit_id: String,
        ?request_options: Vers::request_opts
      ) -> void

      def to_hash: -> {
        commit_id: String,
        request_options: Vers::RequestOptions
      }
    end
  end
end
